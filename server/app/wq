import matplotlib.pyplot as plt
import numpy as np

import external.python.mrd as mrd

'''
There are two kinds of mrd files: one with image and one without images. 
This is to separate the choice of mrd files that show up in image viewing fields.

'''
# mrd file with image fields
filename = "images.bin"
# mrd file without image fields
# filename = "phantom.bin"
mongo_db = {}
with mrd.BinaryMrdReader(filename) as r:
    header = r.read_header()
    mongo_db['study_date'] = header.study_information.study_date
    mongo_db['study_time'] = header.study_information.study_time
    mongo_db['protocol_name'] = header.measurement_information.protocol_name
    mongo_db['file_name'] = header.measurement_information.measurement_id + '-' + mongo_db['protocol_name']
    mongo_db['uploader_id'] = ''        # filled in via cognito
    mongo_db['group_id'] = ''           # filled in via cognito
    mongo_db['group_name'] = 'public'   # use public as the name of the first group anyone can see
    mongo_db['location'] = header.acquisition_system_information.station_name
    data_stream = r.read_data()
    for item in data_stream:
        if not isinstance(item, mrd.StreamItem.ImageFloat):
            mongo_db['image_exist'] = False
            pass
        else:
            mongo_db['image_exist'] = True
            image = item.value
            image.data *= 255 / image.data.max()    # scale to max 255
            pixels = image.data.astype(np.uint8)
            for c in range(image.channels()):
                for s in range(image.slices()):
                    plt.imshow(pixels[c,s,:,:],'gray')
                    plt.show()
                    break
    print(mongo_db)
